# Copy this file to .env (only for running locally with `node server.js`).
# On Vercel, set the keys in Project -> Settings -> Environment Variables.
# Every key is optional: without it, the corresponding source simply stays inactive.

# Germany: https://onboarding.tankerkoenig.de (free; one request per minute per key)
TANKERKOENIG_API_KEY=
# Denmark, Go'on: the form at https://goon.nu/faa-adgang-til-api/ (the key arrives by email)
GOON_API_KEY=
# Denmark, Uno-X: email info@unox.dk with the subject "Adgang til pris-API" (OAuth2 client credentials)
UNOX_CLIENT_ID=
UNOX_CLIENT_SECRET=
