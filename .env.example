# Copiază acest fișier ca .env (doar pentru rularea locală cu `node server.js`).
# Pe Vercel, cheile se pun în Project -> Settings -> Environment Variables. Toate sunt opționale:
# fără ele, sursa respectivă rămâne inactivă.
# Germania: https://onboarding.tankerkoenig.de (gratuit, o cerere pe minut)
TANKERKOENIG_API_KEY=
# Danemarca, Go'on: formularul https://goon.nu/faa-adgang-til-api/ (cheia vine automat pe email)
GOON_API_KEY=
# Danemarca, Uno-X: email la info@unox.dk, subiect „Adgang til pris-API” (OAuth2 client credentials)
UNOX_CLIENT_ID=
UNOX_CLIENT_SECRET=
